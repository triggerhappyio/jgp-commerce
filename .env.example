# ── Database (Postgres via Prisma) ──────────────────────────────────────
# Neon or Supabase both work. If your provider pools connections
# (pgbouncer), DATABASE_URL should be the pooled connection string and
# DIRECT_URL the direct one (used only by `prisma migrate`). If your
# provider doesn't pool, set both to the same value.
DATABASE_URL=postgresql://user:password@host:5432/jgp
DIRECT_URL=postgresql://user:password@host:5432/jgp

# ── Stripe ───────────────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — test key while developing, live
# key only once you've gone through Stripe's account activation.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# locally, or the webhook's settings page in the Stripe dashboard once
# deployed. Required for both checkout confirmation AND the reservation
# expiry/release path (checkout.session.expired).
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Auth ─────────────────────────────────────────────────────────────────
# Signs session JWTs. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# ── Cron ─────────────────────────────────────────────────────────────────
# Protects /api/cron/release-reservations (wired up in vercel.json to run
# every 5 minutes) from being called by anyone else. Generate the same way
# as AUTH_SECRET.
CRON_SECRET=

# ── App ──────────────────────────────────────────────────────────────────
# Canonical origin, used as a fallback when building Stripe success/cancel
# URLs (the request's Origin header is used first). Also see README for how
# this plays into the jgpusa.store -> jgpfootwear.store redirect.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Tax (see docs/TAX_SETUP.md) ─────────────────────────────────────────
# Defaults OFF. Do not set to "true" until Stripe Tax is activated AND
# registered for the right jurisdictions in the Stripe Dashboard — this
# var is a statement that the Dashboard side is done, not a switch that
# makes tax calculation happen on its own.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# ── Shipping (see docs/SHIPPING.md) ─────────────────────────────────────
# V1 flat-rate shipping — no carrier integration yet. These defaults are
# placeholders, not JGP's real shipping policy; set real numbers before launch.
SHIPPING_ENABLED=true
SHIPPING_STANDARD_AMOUNT_CENTS=800
SHIPPING_FREE_THRESHOLD_CENTS=15000

# ── Rate limiting (see docs/LAUNCH_HARDENING.md) ────────────────────────
# Required in production — lib/rate-limit.ts throws on startup use if
# missing in production rather than silently falling back to an in-memory
# limiter, which doesn't work correctly across Vercel's serverless
# instances. Optional in development (falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Transactional email (Resend) ────────────────────────────────────────
# Required in production for order/shipping/refund confirmation and
# account-verification emails to actually send — lib/email.ts logs
# instead of sending, and never claims success, when unset.
RESEND_API_KEY=
EMAIL_FROM=

# ── Object storage (Vercel Blob) ────────────────────────────────────────
# Required in production for admin product-image upload
# (app/api/admin/upload-image). Enable the Vercel Blob integration on the
# project — it provisions this token automatically in Vercel's environment
# variables; for local dev, copy it from the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=
