generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon/Supabase-style setups put a connection pooler (pgbouncer) behind
  // DATABASE_URL for app queries, but `prisma migrate` needs a direct,
  // non-pooled connection. If your provider doesn't pool, set DIRECT_URL to
  // the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  STAFF
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// JGP's native sizing is Korean millimeter (220-285). The catalog also needs
// to support US sizing for other brands carried later, so size is stored as
// a display string ("245", "10.5") plus this enum to know how to sort/label it.
enum SizeSystem {
  MM
  US
}

// Split into PaymentStatus + FulfillmentStatus rather than one flat "order
// status" enum — payment and fulfillment change independently (an order can
// be PAID and still UNFULFILLED, or PARTIALLY_REFUNDED and DELIVERED).
// OrderStatus is a third, separate axis: the order envelope's own lifecycle,
// independent of payment/fulfillment detail (e.g. CANCELLED can happen for
// reasons that have nothing to do with a refund).
enum OrderStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

// Which channel actually produced this order. Exists so the JGP database
// never has to guess "was this a real web sale or an imported historical
// record" from side channels like legacyShopifyOrderId being null/not-null
// — as more channels (retail POS, marketplaces) come online, each gets an
// explicit value here rather than another nullable marker field.
enum OrderSource {
  JGP_WEB
  SHOPIFY_HISTORICAL
  ADMIN
  RETAIL
  MARKETPLACE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InventoryTransactionType {
  SALE
  RETURN
  RECEIVING
  TRANSFER
  MANUAL_ADJUSTMENT
  DAMAGE
  EXCHANGE
  RESERVATION
  RELEASE
}

// AVAILABLE (what a customer can buy right now) is never stored — it is
// always (InventoryLevel.quantity - InventoryLevel.reserved), computed in
// app code, so it can't drift from the two real counters.
enum ReservationStatus {
  ACTIVE // held against a live checkout attempt
  COMMITTED // payment confirmed — converted into a real sale
  RELEASED // checkout expired/canceled — stock given back
}

enum ReturnStatus {
  REQUESTED
  RECEIVED
  INSPECTED
  RESTOCKED
  REFUNDED
  REJECTED
  EXCHANGED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
}

// ─────────────────────────────────────────────────────────────────────────
// AUTH — Auth.js (NextAuth) v5 Prisma Adapter shape, plus password auth.
// Session strategy is JWT (see lib/auth.ts), so Session rows aren't written
// today, but the table is kept for a future move to DB sessions / OAuth.
// ─────────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String? // null for accounts that only ever use OAuth/magic-link
  name           String?
  image          String?
  role           Role      @default(CUSTOMER)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  customer Customer?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────
// CUSTOMER — a commerce profile, separate from User (auth identity).
// Guest checkouts create a Customer with no linked User; a customer can
// later "claim" their history by registering with the same email.
// ─────────────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  notes     String? // staff-visible notes, not customer-facing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses   Address[]
  orders      Order[]
  footProfile FootProfile?
  returns     Return[]

  // Lifetime spend and order count are deliberately NOT stored columns —
  // they're derived from Order aggregates (see lib/customers.ts) so they
  // can never drift from the orders that actually exist.
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       AddressType
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("US")
  phone      String?
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([customerId])
}

// Optional. Never blocks checkout. No medical claims — this is a fit/sizing
// record, framed the same way a shoe store's "your size" note would be.
model FootProfile {
  id                  String    @id @default(cuid())
  customerId          String    @unique
  customer            Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leftFootLengthMm    Int?
  rightFootLengthMm   Int?
  leftFootWidthMm     Int?
  rightFootWidthMm    Int?
  preferredJgpSizeMm  Int?
  measurementDate     DateTime?
  measurementLocation String?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// CATALOG
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  category    String
  gender      String
  status      ProductStatus @default(DRAFT)
  sizeSystem  SizeSystem    @default(MM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([status])
}

// A variant is one purchasable color+size combination of a Product.
// SKU example: "W852-BN-245" (product W852, Black/Navy, 245mm).
model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku                 String   @unique
  color               String?
  size                String? // display value, e.g. "245" or "10.5"
  priceCents          Int
  compareAtPriceCents Int?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  images             ProductImage[]
  inventoryLevels    InventoryLevel[]
  inventoryTxns      InventoryTransaction[]
  reservations       Reservation[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  returnItems        ReturnItem[]
  purchaseOrderItems PurchaseOrderItem[]

  // One SKU per exact color+size combination within a product.
  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String? // set when the image is specific to one color
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  url       String
  alt       String
  position  Int             @default(0)

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────────────────
// INVENTORY — variant-and-location-specific, with an append-only audit log.
// InventoryLevel.quantity is the current on-hand count; it is only ever
// changed together with an InventoryTransaction row in the same DB
// transaction (see lib/inventory.ts). Never write to InventoryLevel alone.
// ─────────────────────────────────────────────────────────────────────────

model InventoryLocation {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique // short code, e.g. "KTOWN", "BP", "WH", "ONLINE"
  address   String?
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  levels       InventoryLevel[]
  transactions InventoryTransaction[]
  reservations Reservation[]
  receiving    ReceivingRecord[]
}

model InventoryLevel {
  id         String            @id @default(cuid())
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  locationId String
  location   InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Int               @default(0) // on-hand
  reserved   Int               @default(0) // held against ACTIVE reservations; available = quantity - reserved
  updatedAt  DateTime          @updatedAt

  @@unique([variantId, locationId])
  @@index([locationId])
}

// Ties a stock hold to one checkout attempt (see checkoutAttemptId — an id
// we generate before ever calling Stripe, passed to Stripe as
// client_reference_id, so the webhook can find these rows without depending
// on Stripe having already returned a session id at reservation time).
// Every hold against a variant/location is one of these rows; nothing else
// is allowed to write InventoryLevel.reserved directly (see lib/inventory.ts).
model Reservation {
  id                String            @id @default(cuid())
  variantId         String
  variant           ProductVariant    @relation(fields: [variantId], references: [id])
  locationId        String
  location          InventoryLocation @relation(fields: [locationId], references: [id])
  quantity          Int
  status            ReservationStatus @default(ACTIVE)
  checkoutAttemptId String
  orderId           String?
  order             Order?            @relation(fields: [orderId], references: [id])
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([checkoutAttemptId])
  @@index([variantId, locationId, status])
  @@index([expiresAt, status])
}

model InventoryTransaction {
  id              String                    @id @default(cuid())
  variantId       String
  variant         ProductVariant            @relation(fields: [variantId], references: [id])
  locationId      String
  location        InventoryLocation         @relation(fields: [locationId], references: [id])
  type            InventoryTransactionType
  quantityChange  Int // on-hand delta: positive = stock added, negative = stock removed
  reservedChange  Int @default(0) // reserved-counter delta (RESERVATION/RELEASE write this instead)
  reason          String?
  referenceType   String? // "Order" | "Return" | "PurchaseOrder" | "Manual"
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime                  @default(now())

  @@index([variantId])
  @@index([locationId])
  @@index([referenceType, referenceId])
}

// ─────────────────────────────────────────────────────────────────────────
// CART — persisted for logged-in customers so it survives across devices.
// Guest carts still live client-side in CartContext; a persisted Cart is
// created/merged at login. (Login-time merge is not implemented yet — see
// README NEXT section — but the storage shape is ready for it.)
// ─────────────────────────────────────────────────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  customerId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// ─────────────────────────────────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────────────────────────────────

model Order {
  id          String  @id @default(cuid())
  // Atomic, gap-free-enough human order number. orderSeq is a real Postgres
  // sequence (via autoincrement), so concurrent orders can never collide;
  // orderNumber is the "JGP-10001"-formatted string derived from it at
  // creation time and stored so it never has to be recomputed.
  orderSeq    Int     @unique @default(autoincrement())
  // Nullable so it can be left unset for the instant between order creation
  // and the follow-up update that sets it from the now-known orderSeq —
  // Postgres allows any number of NULLs under a unique constraint, so two
  // concurrent orders never collide on this transient state.
  orderNumber String? @unique

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])
  email      String
  phone      String?

  // Snapshots, not live FKs — an order must keep showing the address it
  // actually shipped to even if the customer edits/deletes it later.
  billingAddress  Json?
  shippingAddress Json?

  currency      String @default("usd")
  subtotalCents Int
  taxCents      Int @default(0)
  shippingCents Int @default(0)
  discountCents Int @default(0)
  totalCents    Int

  // Orders in this system are only ever created once payment is confirmed
  // (the webhook is still the only writer — see app/api/webhooks/stripe).
  // The pre-payment "is this checkout still open" state lives on
  // Reservation, not here, so OrderStatus has no OPEN/PENDING member: by
  // the time a row exists it was already CONFIRMED.
  status            OrderStatus       @default(CONFIRMED)
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  stripeSessionId       String? @unique
  stripePaymentIntentId String?

  trackingNumber String?
  carrier        String?
  notes          String? // internal staff notes

  legacyShopifyOrderId String?
  source               OrderSource @default(JGP_WEB)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        OrderItem[]
  payments     Payment[]
  refunds      Refund[]
  shipments    Shipment[]
  returns      Return[]
  reservations Reservation[]

  @@index([customerId])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@index([source])
}

// Snapshot fields (productName/sku/color/size/unitPriceCents) are captured
// at order time and never recomputed from the live catalog — historical
// orders must stay accurate even if the product is later renamed, repriced,
// or archived. productVariantId is nullable so the row survives a deleted
// variant.
model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  productName      String
  sku              String
  color            String?
  size             String?
  unitPriceCents   Int
  currency         String          @default("usd")
  quantity         Int
  totalCents       Int
  createdAt        DateTime        @default(now())

  returnItems ReturnItem[]

  @@index([orderId])
}

model Payment {
  id                    String   @id @default(cuid())
  orderId               String
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String?  @unique
  amountCents           Int
  currency              String   @default("usd")
  status                String // "succeeded" | "pending" | "failed"
  method                String   @default("card")
  createdAt             DateTime @default(now())

  @@index([orderId])
}

model Refund {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripeRefundId  String?  @unique
  amountCents     Int
  currency        String   @default("usd")
  reason          String?
  status          String   @default("succeeded")
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@index([orderId])
}

model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  status         String    @default("pending")
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────
// RETURNS / EXCHANGES
// ─────────────────────────────────────────────────────────────────────────

model Return {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  customerId String?
  customer   Customer?    @relation(fields: [customerId], references: [id])
  status     ReturnStatus @default(REQUESTED)
  reason     String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  items ReturnItem[]

  @@index([orderId])
  @@index([status])
}

model ReturnItem {
  id                  String         @id @default(cuid())
  returnId            String
  return              Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId         String
  orderItem           OrderItem      @relation(fields: [orderItemId], references: [id])
  productVariantId    String
  productVariant      ProductVariant @relation(fields: [productVariantId], references: [id])
  quantity            Int
  condition           String? // staff-assessed condition on receipt
  restocked           Boolean        @default(false)
  // If set, this line is an exchange rather than a straight refund — the
  // returned variant's stock goes up, this variant's stock goes down.
  exchangeForVariantId String?

  @@index([returnId])
}

// ─────────────────────────────────────────────────────────────────────────
// PURCHASING / RECEIVING
// ─────────────────────────────────────────────────────────────────────────

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  poNumber   String              @unique
  supplierId String
  supplier   Supplier            @relation(fields: [supplierId], references: [id])
  status     PurchaseOrderStatus @default(DRAFT)
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderItem {
  id                String         @id @default(cuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           ProductVariant @relation(fields: [variantId], references: [id])
  quantityOrdered   Int
  quantityReceived  Int            @default(0)
  unitCostCents     Int?

  receivingRecords ReceivingRecord[]

  @@index([purchaseOrderId])
}

model ReceivingRecord {
  id                  String            @id @default(cuid())
  purchaseOrderItemId String
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  locationId          String
  location            InventoryLocation @relation(fields: [locationId], references: [id])
  quantityReceived    Int
  receivedByUserId    String?
  receivedAt          DateTime          @default(now())
  notes               String?

  @@index([purchaseOrderItemId])
}

// ─────────────────────────────────────────────────────────────────────────
// STRIPE WEBHOOK IDEMPOTENCY — logged before any event is acted on, so a
// replay of the exact same event id is a guaranteed no-op regardless of
// whether that event type ever creates/touches an Order (unique constraint
// does the work, not application logic).
// ─────────────────────────────────────────────────────────────────────────

model StripeEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@index([type])
}

// ─────────────────────────────────────────────────────────────────────────
// LEADS — unrelated to the order pipeline, kept from the original build.
// ─────────────────────────────────────────────────────────────────────────

model Consultation {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String?
  location    String    @default("los-angeles")
  preferredAt DateTime?
  notes       String?
  status      String    @default("new") // new | contacted | scheduled | completed | canceled
  createdAt   DateTime  @default(now())
}
